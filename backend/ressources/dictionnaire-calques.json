  "signalements": [
    {
      "motif": "\\boin\\b|\\boint\\b",
      "raison": "« oin » = « oignit » / « oint » selon le temps. À conjuguer à la main."
    },
    {
      "motif": "\\bcorporati(?:f|ve|ves|fs)\\b",
      "raison": "« corporate » ne se traduit pas par « corporatif » : lire « collectif » ou « de l’entreprise »."
    },
    {
      "motif": "\\bquientent\\b|\\bsoutend\\b|\\bhaltait\\b|\\bairent\\b",
      "raison": "Résidus de reconnaissance vocale sans équivalent évident. À réécrire d’après le sens."
    },
    {
      "motif": "\\bGN\\b|\\bERV\\b|\\bNKJV\\b|\\bAKV\\b",
      "raison": "Sigles de versions bibliques anglaises. Remplacer par la version française citée (Segond, BDS…) ou supprimer."
    },
    {
      "motif": "\\b(la|sa|une|de\\s+la)\\s+mer\\b",
      "raison": "« mer » est souvent « mère » : remis à la mère, le lit de la mère, la Terre comme une mère. Chaque occurrence se tranche au contexte."
    },
    {
      "motif": "\\bfin\\b",
      "raison": "« fin » cache parfois le verbe oindre (oint / oins). Les cas identifiés sont corrigés automatiquement ; vérifie les autres."
    },
    {
      "motif": "\\bM[ée]tro\\b",
      "raison": "« Métro » désigne tantôt l'auteur (Myles Munroe), tantôt Jéthro. Seuls les cas explicites sont corrigés."
    },
    {
      "motif": "\\bp[êé]cheur",
      "raison": "« pêcheur » (poisson) contre « pécheur » (péché). Le contexte religieux impose presque toujours « pécheur »."
    },
    {
      "motif": "\\b(but|objectif)\\b",
      "raison": "Le texte alterne « but » et « objectif » sans raison. Choisis un terme et impose-le partout."
    },
    {
      "motif": "\\b(?:ÈRE|ERE|ERV)\\b",
      "raison": "Sigle de version biblique non identifié. AV = King James, GN = Good News. À remplacer par la version française citée ou à supprimer."
    },
    {
      "motif": "6\\s*000\\s+ans",
      "raison": "Salomon se situe à environ 3 000 ans, pas 6 000. Chiffre à recouper avec l'original."
    },
    {
      "motif": "multipli[ée]e?\\s+par\\s+10|25\\s+à\\s+44\\s+ans",
      "raison": "Statistiques sur la dépression : chiffres à recouper avec l'édition d'origine avant toute diffusion."
    },
    {
      "categorie": "style",
      "motif": "\\bEssentiellement,",
      "raison": "Calque de « Essentially ». Alterner avec « Au fond », « En somme », « Autrement dit »."
    },
    {
      "categorie": "style",
      "motif": "\\bPar\\s+conséquent,",
      "raison": "Répété à l'excès. Varier : « Donc », « D'où », « Il s'ensuit que »."
    }
  ]
